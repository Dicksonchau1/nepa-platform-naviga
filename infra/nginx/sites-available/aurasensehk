# /etc/nginx/sites-available/aurasensehk
# SPA site for www.aurasensehk.com (nepa-platform-naviga)
# Reverse-proxy /api/ -> Dockerised FastAPI on 127.0.0.1:8001

# -------- HTTP: redirect everything to HTTPS www --------
server {
    listen 80;
    listen [::]:80;
    server_name aurasensehk.com www.aurasensehk.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://www.aurasensehk.com$request_uri;
    }
}

# -------- HTTPS apex: redirect to www --------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name aurasensehk.com;

    ssl_certificate     /etc/letsencrypt/live/aurasensehk.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aurasensehk.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://www.aurasensehk.com$request_uri;
}

# -------- HTTPS www: the main site --------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.aurasensehk.com;

    ssl_certificate     /etc/letsencrypt/live/aurasensehk.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aurasensehk.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root  /var/www/aurasensehk.com;
    index index.html;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    client_max_body_size 25m;

    # --- Reverse proxy: /api/ -> FastAPI container on :8001 ---
    location /api/ {
        proxy_pass         http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # --- Video: byte-range streaming, no gzip ---
    location ~* \.(mp4|webm|mov)$ {
        mp4;
        gzip off;
        expires 30d;
        access_log off;
        add_header Accept-Ranges bytes;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # --- Hashed static assets: cache forever ---
    location /assets/ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # --- Other static files ---
    location ~* \.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|otf|mp4|webm)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # --- THE FIX for reload-goes-404 ---
    # Any unknown path falls back to index.html so react-router can handle it
    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }

    # Hide dotfiles (but keep ACME challenge working)
    location ~ /\.(?!well-known) { deny all; }
}
